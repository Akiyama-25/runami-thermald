#!/system/bin/sh
# Runami Thermald 命令行控制工具 (runami_ctl)
# 作者: 迷人の爱音

MODDIR="/data/adb/modules/runami_thermald"
DAEMON="${MODDIR}/bin/runami_daemon"
DATADIR="/data/adb/runami_thermald"
CONFIG_FILE="${DATADIR}/config.json"
DEFAULT_CONFIG="${MODDIR}/config/runami.conf"
PID_FILE="${DATADIR}/runami_daemon.pid"

find_xm_charger() {
    for p in \
        "/sys/class/xm_power/charger/charger_thermal" \
        "/sys/class/xm_power/charger_thermal" \
        "/sys/class/xm_power/charge_interface" \
        "/sys/class/xm_power/charger/charge_interface" \
        "/sys/class/xm_power" \
        "/sys/class/power_supply/battery" \
        "/sys/class/qcom-battery"; do
        if [ -f "$p/wired_thermal_remove" ] || [ -f "$p/wired_ctrl_limit" ]; then
            echo "$p"
            return 0
        fi
    done
    if [ -d "/sys/class/xm_power/charger/charger_thermal" ]; then
        echo "/sys/class/xm_power/charger/charger_thermal"
        return 0
    fi
    if [ -d "/sys/class/xm_power" ]; then
        echo "/sys/class/xm_power"
        return 0
    fi
    return 1
}

XM_CHARGER=$(find_xm_charger 2>/dev/null || echo "/sys/class/xm_power/charger/charger_thermal")

ensure_dirs() {
    mkdir -p "${DATADIR}"
    if [ ! -f "${CONFIG_FILE}" ] && [ -f "${DEFAULT_CONFIG}" ]; then
        cp -f "${DEFAULT_CONFIG}" "${CONFIG_FILE}"
    fi
}

reload_daemon() {
    if [ -f "${PID_FILE}" ]; then
        local pid=$(cat "${PID_FILE}" 2>/dev/null)
        if [ -n "$pid" ] && [ -d "/proc/$pid" ]; then
            kill -HUP "$pid" 2>/dev/null || kill -USR1 "$pid" 2>/dev/null
        fi
    fi
}

show_help() {
    echo "Runami Thermald 命令行管理工具"
    echo "用法: runami_ctl <命令> [参数]"
    echo ""
    echo "命令列表:"
    echo "  status            查看当前守护进程运行状态与硬件读数"
    echo "  status-json       输出 JSON 格式状态 (供给 WebUI)"
    echo "  start             启动温控与充电守护进程"
    echo "  stop              停止守护进程并恢复原厂状态"
    echo "  restart           重启守护进程"
    echo "  get-config        输出当前配置文件 JSON"
    echo "  save-config <b64> 接收 base64 编码的 JSON 并保存为配置文件"
    echo "  set-power <W>     设定充电目标功率 (如 18, 27, 33, 45, 67, 90)"
    echo "  set-charge-switch <0|1> 开启或关闭 xm_power 充电调控"
    echo "  games             列出当前 Scene 联动识别到的游戏列表"
    echo "  diagnose          全面诊断系统温控节点与 xm_power 状态"
    echo "  restore           清除覆盖并彻底交回官方原厂温控"
    echo "  log [N]           查看最近运行日志 (默认 100 行)"
    echo "  log-full          输出全部运行日志"
    echo "  export-log        导出完整日志到 /sdcard/Download/"
    echo "  clear-log         清空当前运行日志"
}

ensure_dirs

case "$1" in
    status)
        "$DAEMON" --status
        ;;
    status-json)
        "$DAEMON" --status-json
        ;;
    start)
        "$DAEMON" --start
        ;;
    stop)
        "$DAEMON" --stop
        ;;
    restart)
        "$DAEMON" --stop
        sleep 1
        rm -f "${DATADIR}/runami.log"* "${DATADIR}/state.json"* 2>/dev/null
        "$DAEMON" --start
        ;;
    clear-log)
        rm -f "${DATADIR}/runami.log"* 2>/dev/null
        echo "SUCCESS: Log cleared"
        ;;
    get-config)
        if [ -f "${CONFIG_FILE}" ]; then
            cat "${CONFIG_FILE}"
        elif [ -f "${DEFAULT_CONFIG}" ]; then
            cat "${DEFAULT_CONFIG}"
        else
            echo "{}"
        fi
        ;;
    save-config)
        if [ -n "$2" ]; then
            echo "$2" | base64 -d > "${CONFIG_FILE}" 2>/dev/null
            reload_daemon
            echo "SUCCESS: Config saved"
        else
            echo "ERROR: Missing base64 payload"
            exit 1
        fi
        ;;
    set-power)
        if [ -n "$2" ]; then
            local watts="$2"
            echo "设置目标充电功率为: ${watts} W"
            if [ -d "${XM_CHARGER}" ]; then
                echo 1 > "${XM_CHARGER}/wired_thermal_remove" 2>/dev/null
            fi
            # 更新 config.json 中的 target_watts
            if [ -f "${CONFIG_FILE}" ]; then
                sed -i -E "s/\"target_watts\"[[:space:]]*:[[:space:]]*[0-9]+/\"target_watts\": ${watts}/" "${CONFIG_FILE}" 2>/dev/null
                reload_daemon
            fi
            echo "SUCCESS: Charge target watts updated to ${watts}W"
        else
            echo "错误: 请提供目标功率值 (例如: runami_ctl set-power 45)"
            exit 1
        fi
        ;;
    set-charge-switch)
        if [ "$2" = "1" ] || [ "$2" = "true" ]; then
            echo "启用 xm_power 充电闭环管理"
            if [ -d "${XM_CHARGER}" ]; then
                echo 1 > "${XM_CHARGER}/wired_thermal_remove" 2>/dev/null
            fi
            sed -i -E 's/\"enabled\"[[:space:]]*:[[:space:]]*false/\"enabled\": true/' "${CONFIG_FILE}" 2>/dev/null
        else
            echo "停用 xm_power 充电闭环管理，交回官方"
            if [ -d "${XM_CHARGER}" ]; then
                echo 0 > "${XM_CHARGER}/wired_thermal_remove" 2>/dev/null
                echo 12 > "${XM_CHARGER}/wired_ctrl_limit" 2>/dev/null
            fi
            sed -i -E 's/\"enabled\"[[:space:]]*:[[:space:]]*true/\"enabled\": false/' "${CONFIG_FILE}" 2>/dev/null
        fi
        reload_daemon
        echo "SUCCESS: Charge switch updated"
        ;;
    games)
        echo "=== Scene 游戏列表读取 ==="
        local found=0
        for xml in /data/data/com.omarea.vtools/shared_prefs/games.xml /data/user/0/com.omarea.vtools/shared_prefs/games.xml; do
            if [ -f "$xml" ]; then
                echo "读取配置文件: $xml"
                grep -o '<boolean name="[^"]*" value="true"' "$xml" 2>/dev/null | sed -E 's/<boolean name="([^"]*)" value="true"/  - \1/'
                found=1
                break
            fi
        done
        if [ "$found" -eq 0 ]; then
            echo "  (未找到 Scene games.xml)"
        fi
        ;;
    custom-games)
        echo "=== 自定义游戏列表 (高优先级) ==="
        local cfg="${CONFIG_FILE}"
        if [ ! -f "$cfg" ]; then cfg="${DEFAULT_CONFIG}"; fi
        awk '/"custom_games"/, /]/' "$cfg" 2>/dev/null | grep -o '"[a-zA-Z0-9_.]\+"' | grep '\.' | tr -d '"' | while read -r pkg; do
            echo "  - $pkg"
        done
        ;;
    list-user-apps)
        # 仅搜索用户空间应用 (-3，带超时保护)
        if command -v timeout >/dev/null 2>&1; then
            if command -v pm >/dev/null 2>&1; then
                timeout 3 pm list packages -3 2>/dev/null | sed -e 's/^package://' | sort
            elif command -v cmd >/dev/null 2>&1; then
                timeout 3 cmd package list packages -3 2>/dev/null | sed -e 's/^package://' | sort
            fi
        else
            if command -v pm >/dev/null 2>&1; then
                pm list packages -3 2>/dev/null | sed -e 's/^package://' | sort
            elif command -v cmd >/dev/null 2>&1; then
                cmd package list packages -3 2>/dev/null | sed -e 's/^package://' | sort
            fi
        fi
        ;;
    diagnose)
        echo "=== Runami Thermald 节点诊断报告 ==="
        echo "机型代号: $(getprop ro.product.device || echo unknown) ($(getprop ro.product.name))"
        echo "系统版本: $(getprop ro.build.version.incremental)"
        echo "mi_thermald 覆盖目录: /data/vendor/thermal/config"
        ls -la /data/vendor/thermal/config 2>/dev/null || echo "（未创建覆盖文件）"
        echo "xm_power 节点状态:"
        if [ -d "${XM_CHARGER}" ]; then
            echo "  wired_thermal_remove: $(cat ${XM_CHARGER}/wired_thermal_remove 2>/dev/null)"
            echo "  wired_ctrl_limit: $(cat ${XM_CHARGER}/wired_ctrl_limit 2>/dev/null)"
        else
            echo "  警告: 当前机型或内核未挂载 xm_power 节点！"
        fi
        echo "CPU 核心在线状态:"
        for i in 0 1 2 3 4 5 6 7; do
            echo -n "  cpu$i: $(cat /sys/devices/system/cpu/cpu$i/online 2>/dev/null || echo 1) "
        done
        echo ""
        ;;
    restore)
        echo "正在停止守护进程..."
        "$DAEMON" --stop
        echo "正在清除 /data/vendor/thermal/config 覆盖文件..."
        rm -rf /data/vendor/thermal/config/*
        echo "正在恢复 xm_power 官方充电档位..."
        echo 0 > "${XM_CHARGER}/wired_thermal_remove" 2>/dev/null
        echo 12 > "${XM_CHARGER}/wired_ctrl_limit" 2>/dev/null
        echo "触发 mi_thermald 重载..."
        setprop ctl.restart mi_thermald 2>/dev/null || echo 0 > /sys/class/thermal/thermal_message/sconfig 2>/dev/null
        echo "官方原厂温控已完全恢复！"
        ;;
    log)
        local lines="${2:-100}"
        for log_path in "/data/adb/runami_thermald/runami.log" "${DATADIR}/runami.log"; do
            if [ -f "$log_path" ]; then
                tail -n "$lines" "$log_path"
                exit 0
            fi
        done
        echo "[$(date '+%m-%d %H:%M:%S')] Runami Thermald 已启动，暂无异常日志。"
        ;;
    log-full)
        for log_path in "/data/adb/runami_thermald/runami.log" "${DATADIR}/runami.log"; do
            if [ -f "$log_path" ]; then
                cat "$log_path"
                exit 0
            fi
        done
        echo "[$(date '+%m-%d %H:%M:%S')] 暂无运行日志记录。"
        ;;
    export-log)
        local src=""
        for lp in "/data/adb/runami_thermald/runami.log" "${DATADIR}/runami.log"; do
            if [ -f "$lp" ]; then
                src="$lp"
                break
            fi
        done
        if [ -z "$src" ]; then
            echo "ERROR: Log file not found"
            exit 1
        fi

        local out_dir=""
        for d in "/sdcard/Download" "/storage/emulated/0/Download" "/sdcard" "/storage/emulated/0" "${DATADIR}"; do
            if [ -d "$d" ] && [ -w "$d" ]; then
                out_dir="$d"
                break
            fi
        done
        if [ -z "$out_dir" ]; then
            out_dir="/sdcard/Download"
            mkdir -p "$out_dir" 2>/dev/null
        fi

        local out_file="${out_dir}/runami_thermald_$(date '+%Y%m%d_%H%M%S').log"
        if cp -f "$src" "$out_file" 2>/dev/null; then
            chmod 666 "$out_file" 2>/dev/null
            echo "$out_file"
        else
            out_file="${DATADIR}/runami_export.log"
            cp -f "$src" "$out_file" 2>/dev/null
            chmod 666 "$out_file" 2>/dev/null
            echo "$out_file"
        fi
        ;;
    *)
        show_help
        ;;
esac