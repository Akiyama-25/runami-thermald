#!/system/bin/sh
# Runami Thermald - 核心温控与充电守护进程
# 专为小米 14 (houji) 及 SM8650 旗舰平台定制
# 作者: 迷人の爱音

MODDIR="/data/adb/modules/runami_thermald"
DATADIR="/data/adb/runami_thermald"
CONFIG_FILE="${DATADIR}/config.json"
DEFAULT_CONFIG="${MODDIR}/config/runami.conf"
STATE_FILE="${DATADIR}/state.json"
PID_FILE="${DATADIR}/runami_daemon.pid"
LOG_FILE="${DATADIR}/runami.log"
OVERRIDE_DIR="/data/vendor/thermal/config"

XM_CHARGER="/sys/class/xm_power/charger/charger_thermal"
BATT_DIR="/sys/class/power_supply/battery"
THERMAL_MSG="/sys/class/thermal/thermal_message"

find_xm_charger() {
    for p in \
        "/sys/class/xm_power/charger/charger_thermal" \
        "/sys/class/xm_power/charger_thermal" \
        "/sys/class/xm_power/charge_interface" \
        "/sys/class/xm_power/charger/charge_interface" \
        "/sys/class/xm_power" \
        "/sys/class/power_supply/battery" \
        "/sys/class/qcom-battery"; do
        if [ -f "$p/wired_thermal_remove" ] || [ -f "$p/wired_ctrl_limit" ]; then
            echo "$p"
            return 0
        fi
    done
    if [ -d "/sys/class/xm_power/charger/charger_thermal" ]; then
        echo "/sys/class/xm_power/charger/charger_thermal"
        return 0
    fi
    if [ -d "/sys/class/xm_power" ]; then
        echo "/sys/class/xm_power"
        return 0
    fi
    return 1
}

XM_CHARGER=$(find_xm_charger 2>/dev/null || echo "/sys/class/xm_power/charger/charger_thermal")

mkdir -p "${DATADIR}"
mkdir -p "${DATADIR}/templates"
mkdir -p "${OVERRIDE_DIR}"

log() {
    local msg="[$(date '+%m-%d %H:%M:%S')] $1"
    echo "$msg"
    echo "$msg" >> "${LOG_FILE}" 2>/dev/null
}

load_config() {
    if [ ! -f "${CONFIG_FILE}" ]; then
        if [ -f "${DEFAULT_CONFIG}" ]; then
            cp -f "${DEFAULT_CONFIG}" "${CONFIG_FILE}"
        fi
    fi
    # 提取关键阈值
    WALL_GAME=$(grep -A 8 '"screen_on_game"' "${CONFIG_FILE}" 2>/dev/null | grep '"thermal_wall"' | grep -o '[0-9]*' | head -n1)
    WALL_DAILY=$(grep -A 8 '"screen_on_daily"' "${CONFIG_FILE}" 2>/dev/null | grep '"thermal_wall"' | grep -o '[0-9]*' | head -n1)
    WALL_CHARGE=$(grep -A 8 '"screen_on_charge"' "${CONFIG_FILE}" 2>/dev/null | grep '"thermal_wall"' | grep -o '[0-9]*' | head -n1)
    WALL_OFF_CHG=$(grep -A 8 '"screen_off_charge"' "${CONFIG_FILE}" 2>/dev/null | grep '"thermal_wall"' | grep -o '[0-9]*' | head -n1)
    TARGET_W=$(grep -A 8 '"charge_control"' "${CONFIG_FILE}" 2>/dev/null | grep '"target_watts"' | grep -o '[0-9]*' | head -n1)

    WALL_GAME=${WALL_GAME:-52}
    WALL_DAILY=${WALL_DAILY:-46}
    WALL_CHARGE=${WALL_CHARGE:-44}
    WALL_OFF_CHG=${WALL_OFF_CHG:-45}
    TARGET_W=${TARGET_W:-45}

    CUSTOM_GAMES=$(awk '/"custom_games"/, /]/' "${CONFIG_FILE}" 2>/dev/null | grep -o '"[a-zA-Z0-9_.]\+"' | grep '\.' | tr -d '"' | tr '\n' ' ')
    WALL_OFF_IDLE=$(grep -A 8 '"screen_off_idle"' "${CONFIG_FILE}" 2>/dev/null | grep '"thermal_wall"' | grep -o '[0-9]*' | head -n1)
    WALL_OFF_IDLE=${WALL_OFF_IDLE:-42}
}

# 屏幕点亮/熄屏状态多源权威探测 (解决 HyperOS / Android 熄屏识别失效问题)
check_screen_on() {
    # 1. 尝试从 thermal_message 驱动节点直接读取
    for sf in "${THERMAL_MSG}/screen_state" "/sys/class/thermal/thermal_message/screen_state"; do
        if [ -r "$sf" ]; then
            local raw=$(cat "$sf" 2>/dev/null)
            if [ "$raw" = "0" ]; then
                echo 0
                return
            elif [ "$raw" = "1" ]; then
                echo 1
                return
            fi
        fi
    done

    # 2. Android Framework 权威电源状态检测 (dumpsys power 前 35 行极速截取)
    if command -v dumpsys >/dev/null 2>&1; then
        local pwr=$(dumpsys power 2>/dev/null | head -n 35)
        if [ -n "$pwr" ]; then
            local wake=$(echo "$pwr" | grep -m1 "mWakefulness=" | cut -d'=' -f2 | tr -d '\r\n ')
            if [ -n "$wake" ]; then
                case "$wake" in
                    Awake)
                        echo 1
                        return
                        ;;
                    Asleep|Dozing|Dreaming)
                        echo 0
                        return
                        ;;
                esac
            fi

            if echo "$pwr" | grep -qE "mIsInteractive[:=][[:space:]]*false|mInteractive[:=][[:space:]]*false"; then
                echo 0
                return
            fi
            if echo "$pwr" | grep -qE "mIsInteractive[:=][[:space:]]*true|mInteractive[:=][[:space:]]*true"; then
                echo 1
                return
            fi
        fi

        # 3. 备选检测: dumpsys display 状态
        local d_state=$(dumpsys display 2>/dev/null | grep -m1 -E "mState=OFF|mActualDisplayState=OFF|mState=ON|mActualDisplayState=ON")
        if [ -n "$d_state" ]; then
            if echo "$d_state" | grep -qi "OFF"; then
                echo 0
                return
            else
                echo 1
                return
            fi
        fi
    fi

    # 4. 备选检查: 背光亮度是否为 0
    for bl in /sys/class/backlight/*/brightness; do
        if [ -r "$bl" ]; then
            local bv=$(cat "$bl" 2>/dev/null || echo -1)
            if [ "$bv" = "0" ]; then
                echo 0
                return
            fi
        fi
    done

    # 5. 默认兜底为亮屏 (1)
    echo 1
}

# 7-NTC 传感矩阵读取与加权板温合成 (带多层 fallback)
read_sensors() {
    local board_raw=0
    if [ -f "${THERMAL_MSG}/board_sensor_temp" ]; then
        board_raw=$(cat "${THERMAL_MSG}/board_sensor_temp" 2>/dev/null || echo 0)
    fi

    if [ "$board_raw" -gt 1000 ]; then
        BOARD_TEMP=$((board_raw / 1000))
    elif [ "$board_raw" -gt 0 ]; then
        BOARD_TEMP=$board_raw
    else
        # 扫描 thermal_zone quiet_therm 或 cpu_therm
        local tz_val=0
        for tz in /sys/class/thermal/thermal_zone*; do
            if [ -d "$tz" ]; then
                local t_type=$(cat "$tz/type" 2>/dev/null)
                case "$t_type" in
                    quiet_therm|cpu_therm|pa_therm0)
                        tz_val=$(cat "$tz/temp" 2>/dev/null || echo 0)
                        if [ "$tz_val" -gt 1000 ]; then
                            BOARD_TEMP=$((tz_val / 1000))
                            break
                        fi
                        ;;
                esac
            fi
        done
        if [ "$BOARD_TEMP" = "" ] || [ "$BOARD_TEMP" -le 0 ]; then
            BOARD_TEMP=36
        fi
    fi

    local batt_raw=$(cat "${BATT_DIR}/temp" 2>/dev/null || echo 310)
    if [ "$batt_raw" -gt 1000 ]; then
        BATT_TEMP=$((batt_raw / 1000))
    else
        BATT_TEMP=$((batt_raw / 10))
    fi
    if [ "$BATT_TEMP" -le 0 ]; then
        BATT_TEMP=32
    fi

    local volt_raw=$(cat "${BATT_DIR}/voltage_now" 2>/dev/null || echo 4100000)
    local curr_raw=$(cat "${BATT_DIR}/current_now" 2>/dev/null || echo 0)
    if [ "$curr_raw" -lt 0 ]; then
        curr_raw=$(( -curr_raw ))
    fi
    BATT_WATTS=$(( (curr_raw / 1000) * (volt_raw / 1000) / 1000000 ))
    if [ "$BATT_WATTS" -lt 0 ]; then
        BATT_WATTS=0
    fi

    BATT_STATUS=$(cat "${BATT_DIR}/status" 2>/dev/null || echo "Discharging")
    if [ "$BATT_STATUS" = "Charging" ] || [ "$BATT_STATUS" = "Full" ]; then
        IS_CHARGING=1
    else
        IS_CHARGING=0
    fi

    SCREEN_ON=$(check_screen_on)
}

is_ignored_app() {
    case "$1" in
        com.miui.home|com.android.launcher*|com.mi.android.globallauncher|com.android.systemui)
            return 0
            ;;
        *inputmethod*|*ime*|*.keyboard*|*.input*|com.baidu.input*|com.sohu.inputmethod*|com.tencent.qqpinyin*|com.touchtype.swiftkey)
            return 0
            ;;
        com.google.android.inputmethod.latin)
            return 0
            ;;
        com.miui.securityadd|com.miui.securitycenter*|com.xiaomi.misettings)
            return 0
            ;;
        android|system|com.google.android.gms*|io.github.a13e300.ksu|me.bmax.apatch)
            return 0
            ;;
        *)
            return 1
            ;;
    esac
}

get_top_app() {
    local top_pkg=""

    # 策略 1: 优先获取系统当前获焦与恢复态前台活动窗口
    if command -v dumpsys >/dev/null 2>&1; then
        local focus_str=$(dumpsys window 2>/dev/null | grep -E "mCurrentFocus|mFocusedApp" | head -n2)
        if [ -n "$focus_str" ]; then
            local cand=$(echo "$focus_str" | grep -oE "[a-zA-Z0-9._]+/[a-zA-Z0-9._]+" | head -n1 | cut -d'/' -f1)
            if [ -n "$cand" ] && ! is_ignored_app "$cand"; then
                echo "$cand"
                return
            fi
        fi
        local resume_str=$(dumpsys activity activities 2>/dev/null | grep -E "topResumedActivity|mResumedActivity" | head -n2)
        if [ -n "$resume_str" ]; then
            local cand=$(echo "$resume_str" | grep -oE "[a-zA-Z0-9._]+/[a-zA-Z0-9._]+" | head -n1 | cut -d'/' -f1)
            if [ -n "$cand" ] && ! is_ignored_app "$cand"; then
                echo "$cand"
                return
            fi
        fi
    fi

    # 策略 2: 降级回退至 /dev/cpuset/top-app 进程池深度过滤扫描
    for p in /dev/cpuset/top-app/cgroup.procs /dev/cpuset/top-app/tasks; do
        if [ -f "$p" ]; then
            for pid in $(cat "$p" 2>/dev/null); do
                if [ -d "/proc/$pid" ]; then
                    local cmd=$(tr '\0' '\n' < "/proc/$pid/cmdline" 2>/dev/null | head -n1)
                    if [ -n "$cmd" ] && ! is_ignored_app "$cmd"; then
                        case "$cmd" in
                            *.*)
                                echo "$cmd"
                                return
                                ;;
                        esac
                    fi
                fi
            done
        fi
    done

    echo ""
}

get_scene_games() {
    local xml_paths="/data/data/com.omarea.vtools/shared_prefs/games.xml /data/user/0/com.omarea.vtools/shared_prefs/games.xml"
    SCENE_GAMES=""
    for xml in $xml_paths; do
        if [ -f "$xml" ]; then
            SCENE_GAMES=$(grep -o '<boolean name="[^"]*" value="true"' "$xml" 2>/dev/null | sed -E 's/<boolean name="([^"]*)" value="true"/\1/' | tr '\n' ' ')
            break
        fi
    done
}

is_game_app() {
    local pkg="$1"
    if [ -z "$pkg" ]; then
        return 1
    fi
    # 1. 优先匹配用户自定义游戏列表 (优先级最高)
    for g in $CUSTOM_GAMES; do
        if [ "$pkg" = "$g" ]; then
            GAME_SOURCE="custom"
            return 0
        fi
    done
    # 2. 其次匹配 Scene 游戏列表
    for g in $SCENE_GAMES; do
        if [ "$pkg" = "$g" ]; then
            GAME_SOURCE="scene"
            return 0
        fi
    done
    GAME_SOURCE=""
    return 1
}

enforce_cores_online() {
    for c in 3 4 7; do
        local node="/sys/devices/system/cpu/cpu${c}/online"
        if [ -f "$node" ]; then
            local state=$(cat "$node" 2>/dev/null || echo 1)
            if [ "$state" = "0" ]; then
                echo 1 > "$node" 2>/dev/null
                log "防拔核守卫: CPU $c 已重新恢复为 Online 在线"
            fi
        fi
    done
}

regulate_charging() {
    local target_w="$1"
    if [ ! -d "${XM_CHARGER}" ]; then
        local detected=$(find_xm_charger 2>/dev/null)
        if [ -n "$detected" ]; then
            XM_CHARGER="$detected"
        else
            return
        fi
    fi

    if [ "$IS_CHARGING" -eq 1 ]; then
        echo 1 > "${XM_CHARGER}/wired_thermal_remove" 2>/dev/null
        local cur_gear=$(cat "${XM_CHARGER}/wired_ctrl_limit" 2>/dev/null || echo 12)
        if [ "$BATT_WATTS" -gt "$((target_w + 2))" ]; then
            if [ "$cur_gear" -lt 12 ]; then
                echo "$((cur_gear + 1))" > "${XM_CHARGER}/wired_ctrl_limit" 2>/dev/null
            fi
        elif [ "$BATT_WATTS" -lt "$((target_w - 3))" ]; then
            if [ "$BATT_TEMP" -lt 45 ] && [ "$cur_gear" -gt 3 ]; then
                echo "$((cur_gear - 1))" > "${XM_CHARGER}/wired_ctrl_limit" 2>/dev/null
            fi
        fi
    else
        echo 0 > "${XM_CHARGER}/wired_thermal_remove" 2>/dev/null
    fi
}

update_module_prop() {
    local prop="${MODDIR}/module.prop"
    if [ -f "$prop" ]; then
        local desc="【${STATUS_TITLE:-运行中}】${ACTIVE_PROFILE_NAME:-日常亮屏} | 板温:${BOARD_TEMP}°C 电池:${BATT_TEMP}°C | 功率:${BATT_WATTS}W | 8核防拔核:生效中"
        sed -i -E "s|^description=.*|description=${desc}|" "$prop" 2>/dev/null
    fi
}

dump_status_json() {
    read_sensors
    get_scene_games
    local top=$(get_top_app)
    local is_g="false"
    if is_game_app "$top"; then
        is_g="true"
    fi

    if [ ! -d "${XM_CHARGER}" ]; then
        local detected=$(find_xm_charger 2>/dev/null)
        if [ -n "$detected" ]; then
            XM_CHARGER="$detected"
        fi
    fi

    local xm_gear=$(cat "${XM_CHARGER}/wired_ctrl_limit" 2>/dev/null || echo 12)
    local xm_remove=$(cat "${XM_CHARGER}/wired_thermal_remove" 2>/dev/null || echo 0)

    local f0=$(cat /sys/devices/system/cpu/cpufreq/policy0/scaling_cur_freq 2>/dev/null || echo 1228800)
    local f2=$(cat /sys/devices/system/cpu/cpufreq/policy2/scaling_cur_freq 2>/dev/null || echo 1785600)
    local f5=$(cat /sys/devices/system/cpu/cpufreq/policy5/scaling_cur_freq 2>/dev/null || echo 1785600)
    local f7=$(cat /sys/devices/system/cpu/cpufreq/policy7/scaling_cur_freq 2>/dev/null || echo 2265600)
    local gpu_clk=$(cat /sys/class/kgsl/kgsl-3d0/gpuclk 2>/dev/null || echo 315000000)

    local is_daemon_running="false"
    if [ -f "${PID_FILE}" ]; then
        local dpid=$(cat "${PID_FILE}" 2>/dev/null)
        if [ -n "$dpid" ] && [ -d "/proc/$dpid" ]; then
            is_daemon_running="true"
        fi
    fi

    if [ -f "${STATE_FILE}" ]; then
        . "${STATE_FILE}" 2>/dev/null
    fi

    if [ -z "$CURRENT_WALL" ]; then
        load_config
        if [ "$is_g" = "true" ]; then
            CURRENT_WALL="${WALL_GAME:-52}°C"
            CORES_LOCKED=1
        elif [ "$SCREEN_ON" -eq 1 ] && [ "$IS_CHARGING" -eq 1 ]; then
            CURRENT_WALL="${WALL_CHARGE:-44}°C"
            CORES_LOCKED=1
        elif [ "$SCREEN_ON" -eq 0 ] && [ "$IS_CHARGING" -eq 1 ]; then
            CURRENT_WALL="${WALL_OFF_CHG:-45}°C"
            CORES_LOCKED=1
        elif [ "$SCREEN_ON" -eq 1 ]; then
            CURRENT_WALL="${WALL_DAILY:-46}°C"
            CORES_LOCKED=1
        else
            CURRENT_WALL="${WALL_OFF_IDLE:-42}°C"
            CORES_LOCKED=0
        fi
    fi

    cat <<EOF
{
  "running": ${is_daemon_running},
  "device": "houji (Xiaomi 14)",
  "activeProfile": "${ACTIVE_PROFILE:-screen_on_daily}",
  "activeProfileName": "${ACTIVE_PROFILE_NAME:-日常亮屏模式}",
  "statusTitle": "${STATUS_TITLE:-运行中}",
  "currentWall": "${CURRENT_WALL:-46°C}",
  "coresLocked": $([ "${CORES_LOCKED:-1}" = "1" ] && [ "${is_daemon_running}" = "true" ] && echo true || echo false),
  "topApp": "${top}",
  "isGame": ${is_g},
  "temps": {
    "board": ${BOARD_TEMP:-36},
    "battery": ${BATT_TEMP:-32}
  },
  "power": {
    "charging": $([ "$IS_CHARGING" -eq 1 ] && echo true || echo false),
    "watts": ${BATT_WATTS:-0},
    "xmGear": ${xm_gear},
    "xmRemove": ${xm_remove}
  },
  "screenOn": $([ "$SCREEN_ON" -eq 1 ] && echo true || echo false),
  "cpus": {
    "policy0": $((f0 / 1000)),
    "policy2": $((f2 / 1000)),
    "policy5": $((f5 / 1000)),
    "policy7": $((f7 / 1000)),
    "gpu": $((gpu_clk / 1000000))
  },
  "customGamesCount": $(echo "$CUSTOM_GAMES" | wc -w),
  "sceneGamesCount": $(echo "$SCENE_GAMES" | wc -w),
  "gameSource": "${GAME_SOURCE:-}"
}
EOF
}

main_daemon_loop() {
    log "Runami Thermald 守护进程启动 (PID: $$)..."
    echo $$ > "${PID_FILE}"
    load_config

    trap "load_config; log '配置已热重载'" HUP USR1

    local game_hold=0
    local last_top=""
    local last_screen_on=""
    local last_is_charging=""
    local last_profile=""
    local last_state_save=0

    while true; do
        read_sensors
        get_scene_games
        local top=$(get_top_app)

        # 1. 详细记录前台应用切换
        if [ "$top" != "$last_top" ]; then
            if [ -n "$top" ]; then
                if is_game_app "$top"; then
                    log "[前台应用] 切换至: $top (电竞游戏, 来源: ${GAME_SOURCE:-自定义})"
                else
                    log "[前台应用] 切换至: $top"
                fi
            else
                log "[前台应用] 退回系统桌面或待机"
            fi
            last_top="$top"
        fi

        # 2. 详细记录屏幕状态变化
        if [ -n "$last_screen_on" ] && [ "$SCREEN_ON" != "$last_screen_on" ]; then
            if [ "$SCREEN_ON" -eq 1 ]; then
                log "[屏幕状态] 屏幕点亮 (亮屏)"
            else
                log "[屏幕状态] 屏幕关闭 (熄屏/休眠/AOD)"
            fi
        elif [ -z "$last_screen_on" ]; then
            log "[屏幕状态] 初始检测: $([ "$SCREEN_ON" -eq 1 ] && echo "亮屏" || echo "熄屏")"
        fi
        last_screen_on="$SCREEN_ON"

        # 3. 详细记录充电状态变化
        if [ -n "$last_is_charging" ] && [ "$IS_CHARGING" != "$last_is_charging" ]; then
            if [ "$IS_CHARGING" -eq 1 ]; then
                log "[充电状态] 充电器接入 (状态: ${BATT_STATUS}, 功率: ${BATT_WATTS}W)"
            else
                log "[充电状态] 充电器断开 (电池状态: ${BATT_STATUS})"
            fi
        fi
        last_is_charging="$IS_CHARGING"

        # 4. 判定游戏与防抖逻辑
        if [ "$SCREEN_ON" -eq 0 ]; then
            # 熄屏时立即退出游戏延时保持，切入熄屏方案
            game_hold=0
            CURRENT_TOP="${top:-熄屏待机}"
        elif is_game_app "$top"; then
            CURRENT_TOP="$top"
            game_hold=5
        else
            if [ "$game_hold" -gt 0 ]; then
                game_hold=$((game_hold - 1))
            else
                CURRENT_TOP="$top"
            fi
        fi

        # 5. 核心方案裁决
        if [ "$BATT_TEMP" -ge 48 ] || [ "$BOARD_TEMP" -ge 55 ]; then
            STATUS_TITLE="过热安全保护"
            ACTIVE_PROFILE="safety_guard"
            ACTIVE_PROFILE_NAME="过热回退官方"
            CURRENT_WALL="48°C"
            CORES_LOCKED=0
            echo 0 > "${XM_CHARGER}/wired_thermal_remove" 2>/dev/null
            echo 12 > "${XM_CHARGER}/wired_ctrl_limit" 2>/dev/null
        elif [ "$SCREEN_ON" -eq 0 ] && [ "$IS_CHARGING" -eq 1 ]; then
            STATUS_TITLE="熄屏快充模式"
            ACTIVE_PROFILE="screen_off_charge"
            ACTIVE_PROFILE_NAME="熄屏快充 (${WALL_OFF_CHG}°C / 90W)"
            CURRENT_WALL="${WALL_OFF_CHG}°C"
            CORES_LOCKED=1
            enforce_cores_online
            regulate_charging 90
        elif [ "$SCREEN_ON" -eq 0 ]; then
            STATUS_TITLE="熄屏休眠降温"
            ACTIVE_PROFILE="screen_off_idle"
            ACTIVE_PROFILE_NAME="熄屏低功耗 (${WALL_OFF_IDLE}°C)"
            CURRENT_WALL="${WALL_OFF_IDLE}°C"
            CORES_LOCKED=0
        elif [ "$game_hold" -gt 0 ]; then
            STATUS_TITLE="电竞游戏模式"
            ACTIVE_PROFILE="screen_on_game"
            ACTIVE_PROFILE_NAME="游戏独立温度墙 (${WALL_GAME}°C)"
            CURRENT_WALL="${WALL_GAME}°C"
            CORES_LOCKED=1
            enforce_cores_online
            regulate_charging 18
        elif [ "$SCREEN_ON" -eq 1 ] && [ "$IS_CHARGING" -eq 1 ]; then
            STATUS_TITLE="亮屏充电稳充"
            ACTIVE_PROFILE="screen_on_charge"
            ACTIVE_PROFILE_NAME="亮屏稳充 (${WALL_CHARGE}°C)"
            CURRENT_WALL="${WALL_CHARGE}°C"
            CORES_LOCKED=1
            enforce_cores_online
            regulate_charging "${TARGET_W}"
        else
            STATUS_TITLE="日常亮屏均衡"
            ACTIVE_PROFILE="screen_on_daily"
            ACTIVE_PROFILE_NAME="日常温度墙 (${WALL_DAILY}°C)"
            CURRENT_WALL="${WALL_DAILY}°C"
            CORES_LOCKED=1
            enforce_cores_online
            regulate_charging "${TARGET_W}"
        fi

        cat <<EOF > "${STATE_FILE}.tmp"
ACTIVE_PROFILE="${ACTIVE_PROFILE}"
ACTIVE_PROFILE_NAME="${ACTIVE_PROFILE_NAME}"
STATUS_TITLE="${STATUS_TITLE}"
CURRENT_WALL="${CURRENT_WALL}"
CORES_LOCKED="${CORES_LOCKED}"
GAME_SOURCE="${GAME_SOURCE}"
EOF
        mv -f "${STATE_FILE}.tmp" "${STATE_FILE}" 2>/dev/null

        # 6. 详细记录状态流转日志
        if [ "$ACTIVE_PROFILE" != "$last_profile" ]; then
            log "[状态流转] [${STATUS_TITLE}] ${ACTIVE_PROFILE_NAME} | 目标温度墙: ${CURRENT_WALL} | 板温: ${BOARD_TEMP}°C, 电池: ${BATT_TEMP}°C | 功率: ${BATT_WATTS}W | 核心锁定: $([ "$CORES_LOCKED" -eq 1 ] && echo "是" || echo "否")"
            last_profile="$ACTIVE_PROFILE"
        fi

        local now=$(date +%s)
        if [ $((now - last_state_save)) -ge 5 ]; then
            update_module_prop
            last_state_save=$now
        fi

        sleep 1.5
    done
}

case "$1" in
    --start|-s)
        if [ -f "${PID_FILE}" ]; then
            pid=$(cat "${PID_FILE}" 2>/dev/null)
            if [ -n "$pid" ] && [ -d "/proc/$pid" ]; then
                echo "守护进程已在运行 (PID: $pid)"
                exit 0
            fi
        fi
        nohup "$0" --run >/dev/null 2>&1 &
        echo "Runami Thermald 已启动"
        ;;
    --run)
        main_daemon_loop
        ;;
    --reload)
        load_config
        log "收到外部重载请求，配置已更新"
        ;;
    --stop|-k)
        if [ -f "${PID_FILE}" ]; then
            kill -9 $(cat "${PID_FILE}") 2>/dev/null
            rm -f "${PID_FILE}"
            echo "Runami Thermald 已停止"
        else
            killall -9 runami_daemon 2>/dev/null
        fi
        echo 0 > "${XM_CHARGER}/wired_thermal_remove" 2>/dev/null
        ;;
    --status-json)
        dump_status_json
        ;;
    --status)
        read_sensors
        echo "Runami Thermald 运行状态:"
        echo "板温: ${BOARD_TEMP}°C | 电池: ${BATT_TEMP}°C | 充电状态: ${BATT_STATUS} | 实时功率: ${BATT_WATTS}W"
        echo "Top App: $(get_top_app)"
        ;;
    *)
        echo "用法: $0 {--start|--stop|--reload|--status|--status-json}"
        exit 1
        ;;
esac